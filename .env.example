# Civi-Snap — environment variables
# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# Used in development (falls back to MONGODB_URI, then mongodb://127.0.0.1:27017/civic_issue)
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/civic_issue
# Used in production / on Vercel (e.g. a MongoDB Atlas connection string)
MONGODB_URI=

# --- Auth -----------------------------------------------------------------
# Long random string used to sign JWTs. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- Email OTP (optional) -------------------------------------------------
# Gmail address + app password used to send sign-in codes.
# If unset in development, the code is printed in the server log and shown on
# the sign-in screen ("Local dev mode"). Never shown in production.
EMAIL_USER=
EMAIL_PASS=

# --- AI (optional) --------------------------------------------------------
# Google Gemini key. Enables photo/description fake-report checks and the
# before/after closure check. Without it every AI path degrades gracefully:
# keyword analysis for reports, "AI check unavailable — manual review" for closures.
GEMINI_API_KEY=

# --- Server ---------------------------------------------------------------
PORT=3000
# development | production   (production serves the built dist/ folder)
NODE_ENV=development
# Set to "true" to disable Vite HMR (e.g. inside sandboxed editors)
DISABLE_HMR=
